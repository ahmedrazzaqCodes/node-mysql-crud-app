<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All users</title>
    <style>
        th,td{
            border: 2px solid black;
        }
        th{
            background-color: #1e3a8a;
            color: white;
            padding: 10px;
        }
        td{
            background-color: #ffffff;
            padding: 5px;
        }

        body{
           text-align: center;
           background-color: #f1f5f9;
           font-family: Arial, sans-serif;
        }
        table{
            margin: 0 auto;
            background-color: #ffffff;
            border-spacing: 3px;
        }
        .delete-btn {
    background-color: #DC2626;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
}

.edit-btn:hover {
    background-color: #1D4ED8;
}

.delete-btn:hover {
    background-color: #B91C1C;
}
    </style>
</head>
<body>
    <h1 style="text-decoration: underline;">USERS INFO</h1>
    <table>
        <tr style="background-color: #1e3a8a;">
            <th>id</th>
            <th>username</th>
            <th>email</th>
        </tr>
        <% for(user of users){ %>
            <tr>
                <td><%=user.id%></td>
                <td><%=user.name%></td>
                <td><%=user.email%></td>
                <td>
                    <form method="get" action="/users/<%= user.id%>/edit">
                   <button class="edit-btn">Edit Username</button> 
                   </form>
                </td>
                <td>
                    <form method="POST"
      action="/users/<%= user.id %>?_method=DELETE"
      style="display: inline;"
      onsubmit="return confirm('Are you sure you want to delete this user?');">

    <button type="submit" class="delete-btn">Delete</button>
</form>
                </td>
            </tr>


       <% } %>
    </table>
</body>
</html>